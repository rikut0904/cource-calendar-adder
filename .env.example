# Google CloudでOAuthクライアント（デスクトップアプリ）を作成し、JSONを保存する。
GOOGLE_CREDENTIALS_FILE=credentials.json
# primary またはGoogle Calendarの設定画面にあるカレンダーID
GOOGLE_CALENDAR_ID=primary
GOOGLE_TOKEN_FILE=.calendar-token.json
CALENDAR_SETTINGS_FILE=.calendar-settings.json
CALENDAR_EXPORT_FILE=class-calendar-export.json
CALENDAR_IMPORT_FILE=class-calendar-export.json
CALENDAR_TIMEZONE=Asia/Tokyo
